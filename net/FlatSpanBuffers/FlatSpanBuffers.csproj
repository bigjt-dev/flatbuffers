<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- NuGet package metadata -->
    <PackageId>FlatSpanBuffers</PackageId>
    <Description>A high-performance, zero-allocation FlatBuffers serialization library built on Span&lt;T&gt;. Derived from Google FlatBuffers, shares similar API but enables stack-allocated serialization with AOT compatibility.</Description>
    <PackageTags>flatbuffers;flatbuffer;fbs;span;serialization;zero-allocation;stackalloc;aot;</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/bigjt-dev/flatbuffers/tree/flatspan</PackageProjectUrl>

    <!-- Generate XML docs for IntelliSense in consuming projects -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>


<Project>

  <!-- Centralized version management for all FlatSpanBuffers .NET projects -->
  <PropertyGroup>
    <FlatSpanBuffersVersion>1.1.0</FlatSpanBuffersVersion>
    <Version>$(FlatSpanBuffersVersion)</Version>
    <AssemblyVersion>$(FlatSpanBuffersVersion)</AssemblyVersion>
    <FileVersion>$(FlatSpanBuffersVersion)</FileVersion>
  </PropertyGroup>

  <!-- Shared metadata -->
  <PropertyGroup>
    <Authors>bigjt-dev</Authors>
    <Copyright>Copyright 2014 Google Inc., 2025 bigjt-dev</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/bigjt-dev/flatbuffers</RepositoryUrl>
    <RepositoryBranch>flatspan</RepositoryBranch>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
